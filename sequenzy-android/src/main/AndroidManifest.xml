<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 16 Live Updates: lets the system promote them to the top of
         the shade, the lock screen and a status bar chip. Not a runtime
         permission; the person can turn promotion off per app. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <application>
        <!-- Receives FCM tokens and foreground pushes. Inert unless the app
             depends on com.google.firebase:firebase-messaging. -->
        <service
            android:name="com.sequenzy.android.SequenzyMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Invisible activity a notification tap opens: reports the click,
             then opens the link or the app. Android 12+ forbids doing this
             from a broadcast receiver or service. -->
        <activity
            android:name="com.sequenzy.android.SequenzyNotificationOpenActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Reports a Live Update the person swiped away. -->
        <receiver
            android:name="com.sequenzy.android.SequenzyLiveUpdateReceiver"
            android:exported="false" />

        <!-- Invisible activity that shows the notification permission prompt
             for push primers (Android 13+) and finishes. -->
        <activity
            android:name="com.sequenzy.android.SequenzyPermissionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>
